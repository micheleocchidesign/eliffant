---
import Logo from './LogoElefante.astro';
---

<nav id="navbar" class="main-nav">
  <div class="brand">
    <div class="logo-wrapper">
      <Logo />
    </div>
    <span class="brand-name">eliffant</span>
  </div>

  <button id="menu-toggle" class="hamburger" aria-label="Apri menu">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <ul id="nav-links" class="nav-links">
    <li><a href="#manifesto" class="nav-item">About</a></li>
    <li><a href="#services" class="nav-item">Servizi</a></li>
    <li><a href="#releases" class="nav-item">Releases</a></li>
    <li><a href="#contact" class="nav-item">Contact</a></li>
  </ul>
</nav>

<style>
  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-s) var(--space-l);
    background: rgba(15, 15, 15, 0.9);
    backdrop-filter: blur(12px);
    z-index: 9999 !important;
    transform: translateY(-100%);
    opacity: 0;
    border-bottom: 1px solid rgba(232, 228, 217, 0.1);
  }

  /* ... i tuoi stili .brand, .logo-wrapper, .brand-name rimangono uguali ... */
  .brand { display: flex; align-items: center; gap: 12px; }
  .logo-wrapper { width: 32px; height: 32px; color: var(--color-paper); }
  .brand-name { font-family: var(--font-main); font-size: 1.2rem; font-weight: bold; color: var(--color-paper); }

  .nav-links {
    display: flex;
    gap: var(--space-m);
    list-style: none;
  }

  .nav-links a {
    font-family: var(--font-main);
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 1.5px;
    color: var(--color-paper);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  /* --- HAMBURGER STYLING --- */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    z-index: 10001;
  }

  .hamburger span {
    display: block;
    width: 25px;
    height: 2px;
    background-color: var(--color-paper);
    transition: 0.3s;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .hamburger { display: flex; }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%; /* Nascosto a destra */
      width: 100%;
      height: 100vh;
      background: var(--color-bg);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--space-l);
      transition: right 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    }

    .nav-links.is-active {
      right: 0;
    }

    .nav-links a { font-size: 1.5rem; }

    /* Animazione X */
    .hamburger.is-active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.is-active span:nth-child(2) { opacity: 0; }
    .hamburger.is-active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navLinks = document.getElementById('nav-links');
  const items = document.querySelectorAll('.nav-item, .nav-links a');

  // Toggle Menu Mobile
  menuToggle?.addEventListener('click', () => {
    menuToggle.classList.toggle('is-active');
    navLinks?.classList.toggle('is-active');
    // Blocca lo scroll del body quando il menu è aperto
    document.body.style.overflow = navLinks?.classList.contains('is-active') ? 'hidden' : '';
  });

  // Scroll Fluido e chiusura menu
  items.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      
      if (href?.startsWith('#')) {
        e.preventDefault();
        const target = document.querySelector(href);
        
        // Chiudi menu mobile
        menuToggle?.classList.remove('is-active');
        navLinks?.classList.remove('is-active');
        document.body.style.overflow = '';

        if (target) {
          const offset = 80; // Altezza della navbar
          const bodyRect = document.body.getBoundingClientRect().top;
          const elementRect = target.getBoundingClientRect().top;
          const elementPosition = elementRect - bodyRect;
          const offsetPosition = elementPosition - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }
    });
  });
</script>