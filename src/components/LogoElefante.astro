  const pathElement = document.getElementById("elephant-path");
  const trigger = document.querySelector(".brand-link");

  if (pathElement && trigger) {
    // Morph su Hover
    trigger.addEventListener("mouseenter", () => {
      gsap.to(pathElement, {
        morphSVG: path2,
        //fill: "var(--color-accent)",
        duration: 0.4,
        ease: "power2.out"
      });
    });

    trigger.addEventListener("mouseleave", () => {
      gsap.to(pathElement, {
        morphSVG: path1,
        //fill: "currentColor",
        duration: 0.4,
        ease: "power2.inOut"
      });
    });

    // Funzione Respiro (Idle)
    function breathe() {
      if (!trigger.matches(":hover")) {
        const tl = gsap.timeline();
        tl.to(pathElement, { morphSVG: path2, duration: .4, ease: "sine.inOut" })
          .to(pathElement, { morphSVG: path1, duration: .4, ease: "sine.inOut" }, "+=1");
      }
      gsap.delayedCall(gsap.utils.random(20, 30), breathe);
    }
    
    gsap.delayedCall(10, breathe);
  }
