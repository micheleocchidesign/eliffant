---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
// Importa il componente Image di Astro
import { Image } from 'astro:assets';
// Importa le tue foto dal percorso src/assets
import tabla from '../assets/images/polaroid-tabla.jpg';
import chitarra from '../assets/images/polaroid-chitarra.jpg';
import erryKenzo from '../assets/images/polaroid-erry-kenzo.jpg';
import vinili from '../assets/images/polaroid-vinili.jpg';
import fotoServizi from '../assets/images/mood-servizi.jpg';
import fotoStudio from '../assets/images/erry-studio.jpg'
import vinile from '../assets/images/vinyl.png'
---

<BaseLayout title="ELIFFANT | Etichetta discografica">
  
  <Navbar />

  <main>
    <section class="hero">
		<div class="hero-wrapper">
			<div class="hero-text">
			<h1>eliffant</h1>
			<p class="description">
				Etichetta discografica indipendente.<br />
				C'è da divertirsi.
			</p>
			<div class="scroll-invite">
				<span>Scroll</span>
				<div class="line"></div>
			</div>
			</div>

			<div class="vinyl-container">
        <Image src={vinile} id="vinyl-hero" alt="Eliffant Vinyl"/>
			</div>
		</div>
		</section>
		<section id="manifesto" class="about-section">
			<div class="container about-grid">
				
				<div class="polaroid-stack">
					<div class="polaroid p1">
						<Image src={chitarra} alt="Chitarra Folk" width={400} />
					</div>
					<div class="polaroid p2">
						<Image src={erryKenzo} alt="Erry&Kenzo" width={400} />
					</div>
					<div class="polaroid p3">
						<Image src={vinili} alt="Collezione Vinili" width={400} />
					</div>
					<div class="polaroid p4">
						<Image src={tabla} alt="Tabla indiane" width={400} />
					</div>
				</div>

				<div class="about-wrapper">
					<span class="label">// ABOUT</span>
					<h2>Creare belle vibrazioni.</h2>
					<p class="text-glow">
						Eliffant è una piccola etichetta indipendente radicata nella Svizzera Italiana. 
						Promuoviamo artisti che passano da qui, portando con sé storie, chitarre e visioni. 
						Un laboratorio dove la musica è il filo conduttore tra le persone.
					</p>
				</div>
			</div>
		</section>
		<section id="services" class="services-section">
		<div class="services-bg">
			<Image src={fotoServizi} alt="Servizi Background" width={1920} quality="high" />
			<div class="overlay"></div>
		</div>

		<div class="container services-container">
			<div class="rituals-header">
			<span class="label">// I NOSTRI SERVIZI</span>
			</div>

			<ul class="services-list">
			<li class="service-item">
				<span class="service-num">01</span>
				<div class="service-text">
				<h3>Lo Studio</h3>
				<p>Uno spazio accogliente a due passi da Locarno dove il calore delle valvole incontra la precisione digitale. Produciamo musica, non file.</p>
				</div>
			</li>
			<li class="service-item">
				<span class="service-num">02</span>
				<div class="service-text">
				<h3>L'Etichetta</h3>
				<p>Curiamo tutto il percorso del disco, dall'idea al prodotto finito.</p>
				</div>
			</li>
			<li class="service-item">
				<span class="service-num">03</span>
				<div class="service-text">
				<h3>Il Sociale</h3>
				<p>Supportiamo la scena locale e creiamo connessioni umane che vanno oltre la musica.</p>
				</div>
			</li>
			</ul>
		</div>
		</section>
		<section id="location" class="location-section">
			<div class="container">
				<div class="location-content">
				<span class="label">// DOVE SIAMO</span>
				<h2>Radici in Ticino.</h2>
				<p class="location-address">
					Via Monte Ceneri 20<br />
					6516 Cugnasco, Svizzera
				</p>
				</div>
			</div>

			<div class="map-wide">
				<iframe 
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d44206.324866620096!2d8.877796773368647!3d46.172739785766055!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4785b56125c188eb%3A0xc643b1311dbb283e!2sVia%20Monte%20Ceneri%2020%2C%206516%20Cugnasco%2C%20Svizzera!5e0!3m2!1sit!2sit!4v1773182208567!5m2!1sit!2sit" 
				width="100%" 
				height="100%" 
				style="border:0;" 
				allowfullscreen="" 
				loading="lazy" 
				referrerpolicy="no-referrer-when-downgrade">
				</iframe>
			</div>
		</section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    background-color: var(--color-paper);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    padding: 0 var(--space-l);
    position: relative;
    overflow: visible; /* Mantiene il vinile dentro i confini del sito ma gli permette di sbordare dalla sezione */
  }

  .hero-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .hero-text {
    flex: 1;
    z-index: 10; /* Sopra a tutto */
    pointer-events: none; /* Permette di cliccare ciò che sta sotto se serve */
  }

  .hero-text * {
    pointer-events: auto; /* Riattiva i click per testo e link */
  }

  .hero h1 {
    font-family: var(--font-special);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.85;
    margin-bottom: var(--space-s);
    letter-spacing: -4px;
    text-transform: none;
  }

  .description {
    font-family: var(--font-main);
    font-size: 1.2rem;
    font-weight: 700;
    max-width: 400px;
  }

  .scroll-invite {
    margin-top: var(--space-l); /* Distanza dalla descrizione */
    display: flex;
    align-items: center;
    gap: 15px;
    opacity: 1; /* Discreto, non deve urlare */
  }

  .scroll-invite span {
    font-family: var(--font-main);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-bg);
  }

  .scroll-invite .line {
    width: 30px;
    height: 1px;
    background-color: var(--color-accent); /* Il tocco di fuoco del brand */
    position: relative;
    overflow: hidden;
  }

  /* Animazione minima e fluida della linea */
  .scroll-invite .line::after {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: var(--color-bg);
    animation: line-slide 2.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes line-slide {
    0% { transform: translateX(-101%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(101%); }
  }

  .vinyl-container {
    position: absolute; /* Torna absolute per sbordare liberamente */
    right: -15%;
    top: 80%;
    transform: translateY(-50%);
    width: 60vw; /* Molto grande */
    z-index: 1;
  }

  #vinyl-hero {
    width: 100%;
    height: auto;
    /* Sborda in alto e a destra */
    transform: translateY(-10%) scale(1.1); 
    filter: drop-shadow(0px 0px 50px rgba(0,0,0,0.5));
  }

  /* --- SEZIONE ABOUT --- */
  .about-section {
    padding: var(--space-xl) 0;
    background-color: var(--color-paper);
    color: var(--color-bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Dividiamo lo spazio a metà */
    align-items: center;
    gap: var(--space-xl);
    width: 100%;
  }

  /* --- STYLING TESTI (Ripristinato) --- */
  .about-wrapper {
    text-align: left;
    z-index: 10;
  }

  .label {
    font-family: var(--font-main); /* Courier */
    color: var(--color-accent);
    letter-spacing: 3px;
    font-size: 0.9rem;
    font-weight: 700;
    display: block;
    margin-bottom: var(--space-s);
  }

  .about-wrapper h2 {
    font-family: var(--font-special); /* Special Elite */
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    margin-bottom: var(--space-m);
    letter-spacing: -2px;
    text-transform: none;
  }

  .text-glow {
    font-family: var(--font-main);
    font-size: 1.25rem;
    line-height: 1.6;
    font-weight: 600;
    max-width: 500px;
    opacity: 0.9;
  }

  /* --- POLAROID STACK --- */
  .polaroid-stack {
    position: relative;
    height: 600px; /* Spazio per lo sparpagliamento */
  }

  .polaroid :global(img) {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 1/1; /* Forza il formato quadrato tipico delle polaroid */
    object-fit: cover; /* Taglia l'immagine se non è quadrata invece di distorcerla */
    display: block;
    filter: sepia(0.2) contrast(1.1);
    /* Rimuove eventuali bordi o ombre indesiderate ereditate */
    border: none; 
  }

  .polaroid {
    position: absolute;
    background: #fdfdfd;
    padding: 10px 10px 40px 10px;
    box-shadow: 1px 1px 5px rgba(0,0,0,0.2);
    width: 300px;
    background-image: url('https://www.transparenttextures.com/patterns/natural-paper.png');
	border-radius: 2px;
  }

  /* Posizioni asimmetriche a sinistra */
  .p1 { top: 5%;   left: -5%;  transform: rotate(-4deg); }
  .p2 { top: 15%;  left: 45%;  transform: rotate(12deg); z-index: 2; }
  .p3 { top: 50%;  left: -1%;   transform: rotate(-18deg); }
  .p4 { top: 55%;  left: 55%;  transform: rotate(-11deg); z-index: 3; }


  .services-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-xl) 0;
    color: var(--color-paper);
    overflow: hidden;
  }

  /* Sfondo a tutto schermo */
  .services-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 1;
  }

  .services-bg :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.9) grayscale(0.2); /* Scurisce l'immagine per far leggere il testo */
  }

  .overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    /* Gradiente per dare profondità e "calore" */
    background: linear-gradient(
      to bottom,
      rgba(28, 25, 23, 0.4),
      rgba(28, 25, 23, 0.8)
    );
  }

  .services-container {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    margin: 0 auto;
  }

  .services-header {
    margin-bottom: var(--space-xl);
  }

  .services-header h2 {
    font-family: var(--font-special);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: var(--space-s);
    line-height: 1;
  }

  /* Lista dei Servizi */
  .services-list {
    list-style: none;
    padding: 0;
  }

  .service-item {
    display: flex;
    gap: var(--space-l);
    padding: var(--space-m) 0;
    border-top: 1px solid rgba(245, 242, 237, 0.1);
    transition: all 0.4s ease;
  }

  .service-item:hover {
    border-top-color: var(--color-accent);
    transform: translateX(10px);
  }

  .service-num {
    font-family: var(--font-special);
    color: var(--color-accent);
    font-size: 1.5rem;
    opacity: 0.6;
    padding-top: 0.5rem;
  }

  .service-text h3 {
    font-family: var(--font-special);
    font-size: 2rem;
    margin-bottom: var(--space-s);
    text-transform: lowercase;
  }

  .service-text p {
    font-family: var(--font-main);
    font-size: 1.1rem;
    line-height: 1.5;
    max-width: 600px;
    opacity: 1;
  }
  
  .location-section {
    padding-top: var(--space-xl);
    background-color: var(--color-paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  .location-content {
    max-width: 800px;
    margin: 0 auto var(--space-s) auto;
    text-align: center;
  }

  .location-content h2 {
    font-family: var(--font-special);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.9;
    margin: var(--space-m) 0;
	color: var(--color-bg);
  }

  .location-address {
    font-family: var(--font-main);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-bg);
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  /* --- MAPPA PANORAMICA --- */
  .map-wide {
    width: 100%;
    height: 300px; /* Bassa e molto larga */
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  /* --- MOBILE --- */
  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-xl);
      flex-direction: column;
      justify-content: flex-start;
      overflow: visible;
    }

    .hero-wrapper {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .vinyl-container {
      position: relative; /* Nel flusso per stare sopra */
      right: auto;
      top: auto;
      transform: none;
      width: 110vw;
	  margin-top: -15vh;
      margin-bottom: var(--space-l);
      order: 1; /* Vinile PRIMA */
    }

    .hero-text {
      order: 2; /* Testo DOPO */
      width: 100%;
    }

    .hero h1 {
      font-size: clamp(4rem, 18vw, 6rem);
      letter-spacing: -2px;
    }

	.description{
		margin: 0 auto;
	}

    .scroll-invite {
      display: none; /* Pulizia su mobile */
    }
  	.about-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-l);
    }
    .about-wrapper {
      order: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .polaroid-stack {
      order: 1;
      height: 400px;
      width: 100%;
    }
    .polaroid { width: 260px; }
    .p1 { left: 10%; top: -10%; transform: rotate(-16deg); }
    .p2 { left: 50%; top: -7%; transform: rotate(7deg);}
    .p3 { left: 13%; top: 30%; transform: rotate(14deg); }
    .p4 { left: 45%; top: 35%; transform: rotate(-10deg); }

	.services-section { padding: var(--space-l) var(--space-m); }
    .service-item { flex-direction: column; gap: var(--space-s); }
    .services-bg :global(img) { filter: brightness(0.3); }

	.location-address {
      font-size: 1.3rem;
    }
    .map-wide {
      height: 250px;
    }
}


</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Rotazione Vinile
		gsap.to("#vinyl-hero", {
		rotation: 720,
		//x: 10, // Si sposta leggermente verso destra uscendo mentre scendi
		ease: "none",
		scrollTrigger: {
			trigger: ".hero",
			start: "top top",
			end: "bottom top",
			scrub: 1.5,
		}
	});

    // Comparsa Navbar - puntiamo l'ID definito nel componente
    gsap.to("#navbar", {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".hero",
        start: "30% top", // Appare un po' prima della fine della hero
        toggleActions: "play none none reverse",
      }
    });

	gsap.to(".p1", {
		x: -40,
		y: -40,
		rotation: "-=5",
		ease: "none",
		scrollTrigger: {
			trigger: ".about-section",
			start: "top bottom", 
			end: "bottom top",
			scrub: 1,
		}
	});

	gsap.to(".p2", {
		x: 50,
		y: -70,
		rotation: "+=10",
		ease: "none",
		scrollTrigger: {
			trigger: ".about-section",
			start: "top bottom", 
			end: "bottom top",
			scrub: 1,
		}
	});

	gsap.to(".p3", {
		x: -20,
		rotation: "-=10",
		ease: "none",
		scrollTrigger: {
			trigger: ".about-section",
			start: "top bottom", 
			end: "bottom top",
			scrub: 1.5,
		}
	});

	gsap.to(".p4", {
		x: +20,
		y: +30,
		rotate: "+=20",
		ease: "none",
		scrollTrigger: {
			trigger: ".about-section",
			start: "top bottom", 
			end: "bottom top",
			scrub: 1.5,
		}
	});
  </script>